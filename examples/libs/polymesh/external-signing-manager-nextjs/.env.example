# DFNS Configuration (Server-side - for External Signing Manager API)
DFNS_API_URL=https://api.dfns.co
DFNS_ORG_ID=your-org-id

# WebAuthn Relying Party Configuration (Server-side - sent to frontend via challenge)
RELYING_PARTY_ID=localhost
RELYING_PARTY_NAME=External Signing Manager Example

# Polymesh Network Configuration (Server-side)
POLYMESH_NODE_URL=wss://testnet-rpc.polymesh.live

# Optional: Default username for testing (Frontend)
NEXT_PUBLIC_DEFAULT_USERNAME=your-test-user@example.com