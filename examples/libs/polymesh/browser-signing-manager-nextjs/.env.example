# Environment variables for DFNS Browser Signing Manager Example
# Copy this file to .env.local and fill in your values

# DFNS Configuration
NEXT_PUBLIC_DFNS_BASE_URL=https://api.dfns.ninja
NEXT_PUBLIC_DFNS_ORG_ID=your-org-id-here

# WebAuthn Relying Party Configuration
NEXT_PUBLIC_RELYING_PARTY_ID=localhost
NEXT_PUBLIC_RELYING_PARTY_NAME=DFNS Polymesh Browser Example

# Polymesh Network Configuration
NEXT_PUBLIC_POLYMESH_NODE_URL=wss://testnet-rpc.polymesh.live
NEXT_PUBLIC_POLYMESH_NETWORK=PolymeshTestnet

# Optional: Default username for testing
NEXT_PUBLIC_DEFAULT_USERNAME=your-test-user@example.com